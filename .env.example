# Database connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Kafka (pg_kafka) connection
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Embedding provider: "openai" or "local"
EMBEDDING_PROVIDER=openai

# OpenAI API key (required if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here

# OpenAI model (default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# Local model (if EMBEDDING_PROVIDER=local)
LOCAL_MODEL_NAME=all-MiniLM-L6-v2

# Consumer settings
KAFKA_CONSUMER_GROUP=hippocampus
KAFKA_TOPIC_PATTERN=decisions.*
BATCH_SIZE=100
BATCH_TIMEOUT_MS=500
# Retries before the consumer fail-stops on a persistently failing batch
CONSUMER_MAX_RETRIES=5
CONSUMER_RETRY_BACKOFF_MS=1000
