# Test environment configuration
# These values are configured for running inside the devcontainer

# Database connection (test container on devcontainer network)
TEST_DATABASE_URL=postgresql://postgres:postgres@hippocampus-test-db:5432/hippocampus_test

# Kafka connection (pg_kafka embedded broker)
TEST_KAFKA_SERVERS=localhost:9093

# Embedding provider for tests
# Use "mock" for fast, deterministic tests (default)
# Use "local" for semantic accuracy tests (requires sentence-transformers)
TEST_EMBEDDING_PROVIDER=mock

# Uncomment for local embedding tests (requires: pip install -e '.[dev,local]')
# TEST_EMBEDDING_PROVIDER=local
